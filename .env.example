# Urban Shield AI — Environment Configuration Template
# Copy this file to .env or configure in backend/.env and frontend/.env

# Security & Session
SECRET_KEY=dev-only-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=sqlite:///./urbanshield.db
ALLOW_DB_RESET=false

# Optional External API Keys (Urban Shield AI works 100% out of the box with offline/vector fallbacks)
VITE_GOOGLE_MAPS_API_KEY=
TRAFFIC_API_KEY=
OPENAI_API_KEY=
OPENWEATHER_API_KEY=
MAPBOX_TOKEN=
